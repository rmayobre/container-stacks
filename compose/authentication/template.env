# Copy to .env and fill in the values.

# Hostnames served through Traefik
POCKET_ID_HOST=
LLDAP_HOST=
# IP of your internal DNS server (e.g. the Technitium container from the pwn stack, 10.2.0.2)
INTERNAL_DNS_IP=

# PocketID Variables
# Generate with: openssl rand -base64 32
POCKET_ID_ENCRYPTION_KEY=
# Full public URL, e.g. https://auth.example.com
APP_URL=
TRUST_PROXY=true
# MAXMIND_LICENSE_KEY=
PUID=1000
PGID=1000

#
# LLDAP Variables
#
# Time zone, e.g. America/New_York
TZ=
# Generate each secret with: openssl rand -hex 32
LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=
# Base DN of the directory, e.g. dc=example,dc=com
LLDAP_LDAP_BASE_DN=
# Password for the LLDAP "admin" user (minimum 8 characters)
LLDAP_LDAP_USER_PASS=
