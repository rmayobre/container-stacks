# Copy to .env and fill in the values.

# Base domain used for the wildcard certificate (e.g. example.com)
DOMAIN=
# Email used for Let's Encrypt registration / expiry notices
ACME_EMAIL=
# Hostname for the Traefik dashboard (e.g. dashboard.example.com)
TRAEFIK_DASHBOARD_HOST=
# Linode API token with Domains read/write access (used for the DNS challenge)
TRAEFIK_LINODE_TOKEN=

# Hostname of the Technitium DNS server (e.g. dns.example.com)
DNS_SERVER_HOST=
# Admin password for the Technitium DNS web console
DNS_ADMIN_PASSWORD=
